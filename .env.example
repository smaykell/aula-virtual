# Copia este archivo como .env y ajusta los valores.
# .env esta en .gitignore: nunca subas credenciales reales al repositorio.

# --- Base de datos ---
DB_URL=jdbc:postgresql://localhost:5432/aula_virtual
DB_USER=aula_virtual
DB_PASSWORD=aula_virtual
DB_POOL_SIZE=10

# --- Servidor ---
SERVER_PORT=8080

# --- Seguridad ---
# Clave de firma HS256 en Base64, minimo 32 bytes. Generala con:
#   openssl rand -base64 32
# En el perfil dev hay un valor por defecto; en prod la app no arranca sin esta variable.
JWT_SECRET=
JWT_ISSUER=aula-virtual
JWT_EXPIRATION=PT8H

# --- CORS ---
# Origenes del frontend, separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4200,http://localhost:3000
